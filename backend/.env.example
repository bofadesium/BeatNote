# Optional. Without a key, /note returns a local template note.
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Path to the trained Yale core admission model (not committed). See README.
BEATNOTE_MODEL_PATH=models/admission_model_core.joblib
# SQLite file for clinician alerts (swap for Postgres in production)
BEATNOTE_DB=data/beatnote.db
